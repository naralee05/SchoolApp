@model IEnumerable<SchoolApp.Models.Student>

<h2>បញ្ជីរាយនាមនិសិ្សត</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>អត្តលេខ</th>
            <th>Full Name</th>
            <th>ភេទ</th>
            <th>មធ្យមភាគ</th>
        </tr>
    </thead>
<tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.FullName</td>
            <td>@item.Gender</td>
            <td>@item.GPA.ToString("0.00")</td>
        </tr>
    }
</tbody>